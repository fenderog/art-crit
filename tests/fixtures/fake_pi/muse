#!/usr/bin/env python3
"""Fake Muse Code: a thin live --json stream from `exec`, the rich session only from `export`. No model calls."""
import json
import os
import sys
import tempfile
from pathlib import Path

args = sys.argv[1:]
SESSIONS = Path(tempfile.gettempdir()) / "fake-muse-sessions"


def record(seq, payload_type, payload, session):
    return {"kind": "record", "envelope": {"sequence": seq, "stream": {"kind": "session", "id": session},
            "recorded_at": 1_790_000_000_000_000 + seq * 100_000, "record_type": "event", "durability": "durable",
            "payload_type": payload_type, "payload": payload}}


def run_event(seq, run, event, session):
    return record(seq, "runtime.session", {"kind": "run", "run_id": run, "event": event}, session)


def session_log(session, error):
    usage1 = {"input_tokens": 100, "output_tokens": 10, "cached_tokens": 60, "cache_write_tokens": 0, "cache_read_tokens": 60, "reasoning_tokens": 4}
    usage2 = {"input_tokens": 130, "output_tokens": 20, "cached_tokens": 100, "cache_write_tokens": 0, "cache_read_tokens": 100, "reasoning_tokens": 6}
    call = {"id": "fc_1", "call_id": "call_1", "name": "read_file", "args": json.dumps({"path": f"{os.getcwd()}/output/circle.svg"})}
    events = [
        record(1, "runtime.session.metadata", {"kind": "metadata", "record": {"workspace_root": os.getcwd()}}, session),
        record(2, "runtime.retained_fact", {"kind": "retained_runtime_fact", "run_id": "main", "record": {"payload_type": "top_level_turn.run_origin"}}, session),
        run_event(3, "main", {"kind": "started", "prompt": "brief"}, session),
        run_event(4, "main", {"kind": "reasoning_committed", "text": "Plan.", "encrypted_content": "x"}, session),
        run_event(5, "main", {"kind": "model_completed", "usage": usage1, "model": "muse-spark-1.3", "finish_reason": "tool_calls"}, session),
        run_event(6, "main", {"kind": "assistant_tool_calls_committed", "tool_calls": [call]}, session),
        record(7, "tool_batch.effect.started", {"kind": "tool_batch_effect", "run_id": "main", "record": {"kind": "started", "call_id": "call_1", "tool_name": "read_file"}}, session),
        record(8, "tool_batch.effect.terminal", {"kind": "tool_batch_effect", "run_id": "main", "record": {"kind": "terminal", "call_id": "call_1"}}, session),
        run_event(9, "main", {"kind": "tool_result_batch_committed", "results": [{"tool_call_index": 0, "tool_call_id": "call_1", "text": "svg ok"}]}, session),
        run_event(10, "main", {"kind": "assistant_message_committed", "text": "Done."}, session),
        run_event(11, "main", {"kind": "model_completed", "usage": usage2, "model": "muse-spark-1.3"}, session),
        # a background reminder run that must not count
        run_event(12, "reminder", {"kind": "model_completed", "usage": usage2, "model": "muse-spark-1.3"}, session),
        run_event(13, "main", {"kind": "terminal", "terminal": "failed" if error else "completed",
                               "reason": "model error" if error else None}, session),
    ]
    return {"export_schema_version": 1, "events": events}


if "--version" in args:
    print("Muse Code 1.4.6-fake (1.4.6-R0.1)")
elif args[:1] == ["exec"]:
    if os.environ.get("FAKE_MUSE_ARGV"):
        Path(os.environ["FAKE_MUSE_ARGV"]).write_text(json.dumps(args))
    session = args[args.index("--session-id") + 1]
    Path("output").mkdir(exist_ok=True)
    Path("output/circle.svg").write_text('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10"><circle cx="5" cy="5" r="4"/></svg>')
    SESSIONS.mkdir(exist_ok=True)
    (SESSIONS / f"{session}.json").write_text(json.dumps(session_log(session, bool(os.environ.get("FAKE_MUSE_ERROR")))))
    print(json.dumps({"payload_type": "run.output.delta", "payload": {"text": "Done."}}), flush=True)
    sys.exit(0)
elif args[:1] == ["export"]:
    log = SESSIONS / f"{args[args.index('--session') + 1]}.json"
    if not log.is_file():
        sys.exit(1)
    Path(args[args.index("--out") + 1]).write_text(log.read_text())
    print("wrote session export")
else:
    sys.exit(2)
