config_version=5

[application]
config/name="Misaligned • A family portrait"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=1200
window/size/viewport_height=900
window/size/window_width_override=1000
window/size/window_height_override=750
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.91, 0.88, 0.81, 1)

[web]
threads/enable=false
